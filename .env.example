# ============================================================
# Copy this file to .env  (cp .env.example .env) and fill in the keys.
# .env is never committed to git (see .gitignore).
# Quotes around values are optional — both forms work.
# ============================================================

# --- Adzuna job search (free tier ~1000 calls/month) ---
# Get both at https://developer.adzuna.com  (register, then Dashboard)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Google Gemini: scoring + CV writing ---
# Get at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- JSearch via RapidAPI: LinkedIn/Indeed listings through Google for Jobs ---
# Subscribe to the free Basic plan at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch , then copy the key from
# the Code Snippets panel ('X-RapidAPI-Key') or from My Apps -> Security.
# Optional: the pipeline runs without it, just with fewer sources.
RAPIDAPI_KEY=

# --- Tavily web search: discovering vacancies and company career boards ---
# Get at https://tavily.com (free tier ~1000 searches/month)
# Optional.
TAVILY_API_KEY=
